# Copy this file to .env and fill in your own values. Never commit .env.

# Get one at https://console.anthropic.com (pay-as-you-go, separate from a claude.ai subscription)
ANTHROPIC_API_KEY=

# Optional: override the default summarization model
ANTHROPIC_MODEL=claude-sonnet-5

# Create an internal integration at https://www.notion.so/my-integrations,
# then share the specific pages/databases you want this app to see with it.
NOTION_API_KEY=

# small (default) balances speed/accuracy on CPU; try "medium" for better accuracy, "base" for more speed.
WHISPER_MODEL_SIZE=small

# Comma-separated names/nicknames/jargon Whisper tends to mishear (e.g. a
# pet's nickname, industry slang, a person's name) — biases transcription
# toward these specific words. Example: "Mando Man, Ghoul, RenoPinball"
VOCABULARY_HINTS=

# Speaker-diarization sensitivity (0-2, lower = splits into more speakers,
# higher = merges more aggressively into fewer speakers). Also settable as
# "Speaker detection sensitivity" in Settings — this is just its default.
DIARIZATION_THRESHOLD=0.7

# Estimated spend (computed locally from real token usage, not your actual
# Anthropic balance) at which the app shows an alert banner. Leave blank to
# disable. Also settable as "Alert threshold" in Settings.
SPEND_ALERT_THRESHOLD=

# Exact name of the audio output device (as it appears in Audio MIDI Setup)
# to switch to automatically while recording, e.g. a Multi-Output Device
# combining your speakers + BlackHole. Leave blank to disable auto-switching.
# Requires: brew install switchaudio-osx
RECORDING_OUTPUT_DEVICE=
